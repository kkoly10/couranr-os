# Names only. NEVER commit a value to this file.
#
# Copy to .env.local, fill in real values, and keep that file at mode 600.
# .env.local is gitignored; this file is not.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_COURANR_WEBHOOK_SECRET=

# The Payment Element's key. PUBLIC by design — it is inlined into the browser
# bundle and is not a secret; it identifies the account and can authorize
# nothing. It is listed here because omitting it is what broke payments:
# CouranrPaymentElement.tsx:46-47 does `if (!key) return null`, so with the
# variable unset the card form silently never mounts and every payer sees
# "Card payment is not available right now". It was absent from this file and
# from all three Vercel environments, and nothing failed loudly.
#
# MUST MATCH THE MODE OF STRIPE_SECRET_KEY. A pk_live against an sk_test breaks
# payments exactly as completely as no key at all.
#
# NEXT_PUBLIC_ values are inlined AT BUILD TIME, so setting this in Vercel does
# not fix an existing deployment — it needs a redeploy.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signs the merchant pickup PIN and the recipient drop-off PIN.
#
# There is NO fallback and NO development default: a PIN request without this
# fails closed. At least 32 bytes of real entropy — the accessor rejects an
# empty, short, placeholder or low-entropy value.
#
# Use a DIFFERENT, stable value per environment (local / Preview / Production).
# Rotating it invalidates every active pickup and recipient credential, which
# must then be regenerated.
COURANR_HANDOFF_CODE_SECRET=

GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
