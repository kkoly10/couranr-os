node_modules
.next
.env
.env.local
.DS_Store

# TypeScript incremental build info
*.tsbuildinfo

# e2e run state (contains synthetic fixture ids)
e2e/.state.json
e2e/artifacts/
e2e/artifacts/

# Smoke-gate fixture credentials (generated, never committed)
e2e/.smoke.json

# Adversarial verification scratch. The review agents write live integration
# attacks here — they run the real command modules against a throwaway local
# Postgres, with their own shim and setup script. Same reason e2e/artifacts is
# ignored: it is working material, not a deliverable. Anything worth keeping is
# promoted into tests/ deliberately, wired into vitest.config.ts, and reviewed.
.attack/

# Verification-agent scratch that lands in tests/. The review agents write
# throwaway integration probes named zz-*.test.ts against their own scratch
# databases; they are not repo tests and must not join the suite or the commit.
tests/zz-*.test.ts
tests/scratch/
.next-disposable/

# Generated by Next.js on every dev/build/typegen and NOT to be tracked.
# Next 16.3 docs: "next-env.d.ts is managed by Next.js. Its contents are an
# implementation detail and may change over time. Add it to .gitignore. If your
# project already tracks the file, remove it from Git."
# Concretely here: this repo builds into two distDirs (.next and
# .next-disposable), so the generated import flips between them and the file
# showed up dirty after every e2e run. Verified before untracking that both
# `tsc --noEmit` and the strict canonical config pass in a fresh clone with
# neither next-env.d.ts nor .next present — which is the state CI typechecks in,
# since `typecheck` runs before `build`.
next-env.d.ts
.tooling/
