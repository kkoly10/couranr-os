{
  "name": "couranr-os",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "ci:local": "node scripts/ciLocal.mjs",
    "db:disposable": "node e2e/disposable/up.mjs",
    "db:disposable:down": "node e2e/disposable/up.mjs --down",
    "db:reset": "node e2e/disposable/up.mjs --once",
    "db:test": "node e2e/disposable/dbTest.mjs",
    "check:rls": "node e2e/disposable/dbTest.mjs --rls-only",
    "check:routes": "node scripts/checkRoutes.mjs",
    "check:legacy-imports": "node scripts/checkLegacyImports.mjs",
    "check:canonical-dml": "node scripts/checkCanonicalDmlBoundary.mjs",
    "check:dev-isolation": "node scripts/checkDevServerIsolation.mjs",
    "check:mocks": "node scripts/checkMockMap.mjs",
    "check:images": "node scripts/buildMarketingImages.mjs --check",
    "check:visual-system": "node scripts/checkVisualSystem.mjs",
    "check:visual-registry": "node scripts/visualAuthorityRegistry.mjs",
    "check:drift-ledger": "node scripts/checkDriftLedger.mjs",
    "check:migrations": "vitest run tests/couranr-migrations.test.ts && node scripts/checkMigrationsDestructive.mjs",
    "check:gates:controls": "node scripts/positiveControls.mjs",
    "provision:postgrest": "node scripts/provisionPostgrest.mjs",
    "test:deploy-safety": "node e2e/disposable/deploymentSafety.mjs",
    "test:cus-fragments": "node e2e/disposable/customerHelpFragments.mjs",
    "test:messaging": "node e2e/disposable/authenticatedMessaging.mjs",
    "test:auth-gateway": "node e2e/disposable/authGateway.mjs",
    "test:acceptance": "node e2e/disposable/acceptanceMatrix.mjs",
    "test:pricing-v2": "node e2e/disposable/pricingV2Authority.mjs",
    "test:weight-timing": "node e2e/disposable/weightBandTiming.mjs",
    "test:smart-intake": "node e2e/disposable/smartIntake.mjs",
    "test:foundation-gate-a": "node e2e/disposable/foundationGateA.mjs",
    "test:foundation-backfill": "node e2e/disposable/foundationBackfill.mjs",
    "test:foundation-rollbacks": "node e2e/disposable/foundationRollbacks.mjs",
    "test:business-routing": "node e2e/disposable/businessRoutingAuthority.mjs",
    "typecheck:canonical": "tsc --noEmit -p tsconfig.canonical.json",
    "typecheck:couranr-foundation": "tsc -p tsconfig.couranr-foundation.json",
    "test:release": "node e2e/disposable/releaseAuthorization.mjs",
    "test:release:route": "node e2e/disposable/releaseRoute.mjs",
    "test:idempotency": "node e2e/disposable/idempotencySubstrate.mjs",
    "test:shell-chrome": "node e2e/shellChrome.mjs",
    "test:fonts": "node e2e/fonts.mjs",
    "test:pub001": "node e2e/pub001Gates.mjs",
    "test:pub-family": "node e2e/publicFamilyGates.mjs",
    "test:master-sameday": "node e2e/masterSameDayGates.mjs",
    "images:build": "node scripts/buildMarketingImages.mjs",
    "governance:generate": "node scripts/governance/generate.mjs",
    "check:governance": "node scripts/governance/check.mjs",
    "governance:facts": "node scripts/governance/facts.mjs",
    "couranr:integrity": "node scripts/couranrIntegrity.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "3.1.1",
    "@stripe/stripe-js": "^4.5.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.1",
    "@types/react-dom": "19.2.4",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.7.0",
    "stripe": "^15.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.2",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "jsqr": "1.4.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}
