{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/pilot-credit-e2e": false,
      "main": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':!*.md' ':!docs/*'",
  "crons": [
    {
      "path": "/api/couranr/internal/automation/tick",
      "schedule": "*/5 * * * *"
    }
  ]
}
